# 复制为 .env 并填入真实值（.env 已被 gitignore，勿提交）
# ===== LLM 供应商 1（主）=====
LLM_PROVIDER=agnes
LLM_MODEL=agnes-2.5-flash
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型规格：maxInputTokens=128000 / maxOutputTokens=16000
LLM_MAX_TOKENS=16000
LLM_MAX_INPUT_TOKENS=128000
LLM_TEMPERATURE=0

# ===== LLM 供应商 2（备选，适配层预留）=====
ALT_LLM_PROVIDER=
ALT_LLM_MODEL=
ALT_LLM_BASE_URL=
ALT_LLM_API_KEY=
ALT_LLM_MAX_TOKENS=16000
ALT_LLM_MAX_INPUT_TOKENS=128000
ALT_LLM_TEMPERATURE=0

# ===== Langfuse 全链路追踪 =====
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_ENABLED=true

# ===== 数仓与语义层路径 =====
DUCKDB_PATH=warehouse/ecommerce.duckdb
SEMANTIC_LAYER_PATH=data/semantic_layer/metrics.yaml

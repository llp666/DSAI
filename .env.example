# 复制为 .env 并填入真实值（.env 已被 gitignore，勿提交）
# ===== LLM 供应商 1（主）=====
LLM_PROVIDER=agnes
LLM_MODEL=agnes-2.5-flash
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型规格：maxInputTokens=128000 / maxOutputTokens=16000
LLM_MAX_TOKENS=16000
LLM_MAX_INPUT_TOKENS=128000
LLM_TEMPERATURE=0

# ===== LLM 供应商 2（备选，适配层预留）=====
ALT_LLM_PROVIDER=
ALT_LLM_MODEL=
ALT_LLM_BASE_URL=
ALT_LLM_API_KEY=
ALT_LLM_MAX_TOKENS=16000
ALT_LLM_MAX_INPUT_TOKENS=128000
ALT_LLM_TEMPERATURE=0

# ===== Langfuse 全链路追踪 =====
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_ENABLED=true
# 每题 trace 的 flush 等待上限（秒）。0 = 不等待、纯后台导出。
# Langfuse 未启动时 flush 会阻塞重试约 50s/题，本项把它截断（追踪照常后台导出）
LANGFUSE_FLUSH_TIMEOUT=2

# ===== 数仓与语义层路径 =====
DUCKDB_PATH=warehouse/ecommerce.duckdb
SEMANTIC_LAYER_PATH=data/semantic_layer/metrics.yaml

# ===== 网页搜索 API（keenable，实时性问题：天气/新闻/最新资讯；见 docs/model.md）=====
SEARCH_BASE_URL=https://api.keenable.ai/v1
SEARCH_API_KEY=keen_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== rerank（混合检索重排）=====
# 默认 false：实测 RRF 已截 Top-3，rerank 只能改顺序且让 MRR 变差（0.950 → 0.894），
# 每题还多 ~2s。置 true 恢复；复现 A/B：python -m eval.run_retrieval_eval --hybrid --rerank
RERANK_ENABLED=false
RERANK_PROVIDER=jina
RERANK_BASE_URL=https://api.jina.ai/v1/rerank
RERANK_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RERANK_MODEL=jina-reranker-v3.5
